# No secret is required here: codex-magpie creates a private web.key in the
# persistent service directory. Never commit .env or print its login URL.
CODEX_MAGPIE_ENABLED=true
# Keep enabled until a separately verified Magpie account-pool migration.
CODEX_SUPERVISOR_ENABLED=true
# Optional web agents; port bindings default to host loopback.
T3CODE_ENABLED=false
DSH_WEB_ENABLED=false
DSH_WEB_PUBLIC_URL=https://localhost:3080/
