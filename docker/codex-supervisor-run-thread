#!/usr/bin/env python3
"""Start Codex for a validated cross-account continuation packet.

The old app-server thread belongs to the account that was just cut over and
cannot be resumed under the replacement account. ``--resume-existing`` is
kept as a backwards-compatible flag for older launchers, but it intentionally
does not call ``codex resume`` anymore.
"""

from __future__ import annotations

import json
import os
import sys
import argparse
from pathlib import Path


def fail(message: str) -> int:
    print(f"codex supervisor runner: {message}", file=sys.stderr)
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("packet", help="Continuation packet path")
    parser.add_argument("--resume-existing", action="store_true")
    args = parser.parse_args()

    packet_path = Path(args.packet).resolve()
    handoff_dir = Path(os.environ.get("CODEX_SUPERVISOR_HANDOFF_DIR", "/home/codex/.codex-supervisor/handoffs")).resolve()
    try:
        packet_path.relative_to(handoff_dir)
    except ValueError:
        return fail("packet path is outside the configured handoff directory")
    try:
        packet = json.loads(packet_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return fail("cannot read continuation packet")

    prompt = packet.get("new_thread_prompt")
    workspace = Path(str(packet.get("workspace_path", "/workspace"))).resolve()
    if not isinstance(prompt, str) or not prompt.strip() or not workspace.is_dir():
        return fail("invalid continuation packet")

    codex = os.environ.get("CODEX_SUPERVISOR_CODEX", "/usr/local/bin/codex-real")
    if not Path(codex).is_file():
        return fail("codex-real executable is not installed")
    os.chdir(workspace)

    # A Codex rollout is account-bound. Reusing its ID after codex-switch
    # changes credentials causes the TUI to enter an endless reconnect loop
    # ("app-server session could not be restored"). Always create a fresh
    # thread and carry the continuation instructions into it instead.
    old_thread_id = str(packet.get("dead_thread_id") or "").strip()
    continuation = (
        "账号切换已完成。原账号线程已因额度阈值被硬中断；当前是新账号下的新线程。"
        "请继续执行切换前尚未完成的用户任务。先检查当前工作区、相关进程和已有改动，"
        "避免重复已经完成的操作；不要只回复确认，直接继续执行并报告进展及剩余事项。"
    )
    if old_thread_id:
        continuation += f"原线程标识（仅供审计，不要尝试 resume）：{old_thread_id}。"
    continuation += "\n\n" + prompt

    os.execv(codex, [codex, "--remote", "unix://", "--no-alt-screen", "-C", str(workspace), continuation])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
