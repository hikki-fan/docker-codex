#!/usr/bin/env python3
"""Run deterministic five-hour warmups for two Codex profiles.

The schedule is a 120-hour (five-day) cycle. Account A runs at cycle offset
0, then every five hours. Account B runs at the same cadence with a 150-minute
offset. A small JSON state file makes retries idempotent across polling and
container restarts; only the most recent missed slot is caught up.

No credentials or command output are written to the log. Profile aliases may
be supplied with CODEX_WARMUP_A_ALIAS / CODEX_WARMUP_B_ALIAS. When omitted,
the scheduler discovers profiles through ``codex-switch --json list`` and uses
the first two aliases in sorted order.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import tempfile
import time
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any, Dict, Optional

try:
    import fcntl
except ImportError:  # pragma: no cover - production is POSIX Linux
    fcntl = None

try:
    from zoneinfo import ZoneInfo
except ImportError:  # pragma: no cover - Python 3.11 is required in production
    ZoneInfo = None  # type: ignore[assignment]


SLOT_MINUTES = 5 * 60
CYCLE_SLOTS = 5 * 24 * 60 // SLOT_MINUTES  # 24 slots in a 5-day cycle
B_OFFSET_MINUTES = 150
DEFAULT_TIMEZONE = "Asia/Shanghai"

WARMUP_BIN = Path(os.environ.get("CODEX_WARMUP_BIN", "/home/codex/.local/bin/codex-switch"))
LOG_DIR = Path(os.environ.get("CODEX_WARMUP_LOG_DIR", "/home/codex/.codex-switch/logs"))
LOG_FILE = Path(os.environ.get("CODEX_WARMUP_LOG_FILE", str(LOG_DIR / "warmup.log")))
STATE_FILE = Path(
    os.environ.get(
        "CODEX_WARMUP_STATE_FILE",
        "/home/codex/.codex-supervisor/warmup-scheduler.json",
    )
)
POLL_SECONDS = float(os.environ.get("CODEX_WARMUP_POLL_SECONDS", "20"))
TIMEZONE_NAME = os.environ.get("CODEX_WARMUP_TZ", DEFAULT_TIMEZONE)
EPOCH_TEXT = os.environ.get("CODEX_WARMUP_EPOCH")
NOW_OVERRIDE = os.environ.get("CODEX_WARMUP_NOW")

DEFAULT_RETRY_DELAY_SECONDS = 60.0
RETRY_DELAY_SECONDS = float(
    os.environ.get("CODEX_WARMUP_RETRY_DELAY_SECONDS", str(DEFAULT_RETRY_DELAY_SECONDS))
)
DEFAULT_MAX_RETRIES = 5
MAX_RETRIES = int(os.environ.get("CODEX_WARMUP_MAX_RETRIES", str(DEFAULT_MAX_RETRIES)))


def _redact(value: str) -> str:
    """Remove common account/token-looking values from diagnostic text."""
    value = re.sub(r"[\w.+-]+@[\w.-]+", "[REDACTED_EMAIL]", value)
    value = re.sub(
        r"\b(sk|sess|tok|token)[-_A-Za-z0-9]{8,}\b",
        "[REDACTED_TOKEN]",
        value,
        flags=re.I,
    )
    value = re.sub(
        r"\beyJ[A-Za-z0-9._-]{16,}\b",
        "[REDACTED_JWT]",
        value,
    )
    return re.sub(
        r"(?i)\bBearer\s+[A-Za-z0-9._~+/-]{8,}=*",
        "Bearer [REDACTED_TOKEN]",
        value,
    )[:240]


def tz():
    if ZoneInfo is None:
        return datetime.now().astimezone().tzinfo
    try:
        return ZoneInfo(TIMEZONE_NAME)
    except Exception:
        # Avoid recursive logging here: log() itself needs tz().
        return datetime.now().astimezone().tzinfo


def log(message: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(LOG_FILE.parent, 0o700)
    except OSError:
        pass
    with LOG_FILE.open("a", encoding="utf-8") as handle:
        handle.write(
            f"{datetime.now(tz()).strftime('%Y-%m-%d %H:%M:%S %Z')} "
            f"[warmup-scheduler] {message}\n"
        )
    try:
        os.chmod(LOG_FILE, 0o600)
    except OSError:
        pass


def parse_local_datetime(value: str) -> datetime:
    raw = value.strip()
    if len(raw) == 10:
        raw += "T00:00:00"
    parsed = datetime.fromisoformat(raw)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=tz())
    return parsed.astimezone(tz())


def now() -> datetime:
    if NOW_OVERRIDE:
        return parse_local_datetime(NOW_OVERRIDE)
    return datetime.now(tz())


def initial_state() -> Dict[str, Any]:
    # Without an explicit anchor, make the first local calendar day day 1 and
    # persist it. Subsequent restarts therefore keep the same five-day cycle.
    epoch = EPOCH_TEXT or now().replace(hour=0, minute=0, second=0, microsecond=0).isoformat()
    return {
        "version": 2,
        "epoch": epoch,
        "last_slot": {"A": -1, "B": -1},
        "retry": {"A": None, "B": None},
        "last_post_refresh": {},
    }


def load_state() -> Dict[str, Any]:
    if not STATE_FILE.exists():
        return initial_state()
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("state is not an object")
        last_slot = data.get("last_slot")
        if not isinstance(last_slot, dict):
            last_slot = {}

        retry_raw = data.get("retry")
        retry: Dict[str, Optional[Dict[str, Any]]] = {}
        if isinstance(retry_raw, dict):
            for acct in ("A", "B"):
                entry = retry_raw.get(acct)
                if isinstance(entry, dict):
                    retry[acct] = {
                        "slot": int(entry.get("slot", -1)),
                        "attempts": int(entry.get("attempts", 0)),
                        "next_retry_at": str(entry.get("next_retry_at", "")),
                        "reason": str(entry.get("reason", "")),
                    }
                else:
                    retry[acct] = None
        else:
            retry = {"A": None, "B": None}

        last_post_refresh = data.get("last_post_refresh")
        if not isinstance(last_post_refresh, dict):
            last_post_refresh = {}

        return {
            "version": 2,
            "epoch": str(data.get("epoch") or initial_state()["epoch"]),
            "last_slot": {
                "A": int(last_slot.get("A", -1)),
                "B": int(last_slot.get("B", -1)),
            },
            "retry": retry,
            "last_post_refresh": last_post_refresh,
        }
    except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
        log(f"state unreadable; starting conservatively: {_redact(str(exc))}")
        return initial_state()


def save_state(state: Dict[str, Any]) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(STATE_FILE.parent, 0o700)
    except OSError:
        pass
    fd, name = tempfile.mkstemp(prefix="warmup-", suffix=".tmp", dir=str(STATE_FILE.parent))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, STATE_FILE)
    except Exception:
        try:
            os.unlink(name)
        except OSError:
            pass
        raise


def refresh_and_discover_aliases() -> Optional[Dict[str, str]]:
    explicit_a = os.environ.get("CODEX_WARMUP_A_ALIAS", "").strip()
    explicit_b = os.environ.get("CODEX_WARMUP_B_ALIAS", "").strip()
    if explicit_a or explicit_b:
        if not (explicit_a and explicit_b):
            log("failed: both CODEX_WARMUP_A_ALIAS and CODEX_WARMUP_B_ALIAS are required")
            return None

    try:
        result = subprocess.run(
            [str(WARMUP_BIN), "--json", "list", "--force"],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
        if result.returncode != 0:
            detail = _redact((result.stderr or result.stdout or "").strip())
            log(
                "failed: forced profile refresh returned "
                f"exit_code={result.returncode} detail={detail or 'no diagnostic output'}"
            )
            return None
        data = json.loads(result.stdout)
        profiles = data.get("profiles", []) if isinstance(data, dict) else []
        aliases = sorted(
            {
                str(item.get("alias", "")).strip()
                for item in profiles
                if isinstance(item, dict) and item.get("alias")
            }
        )
        if explicit_a and explicit_b:
            missing = sorted({explicit_a, explicit_b} - set(aliases))
            if missing:
                log(f"failed: {len(missing)} configured warmup profile(s) were not found")
                return None
            return {"A": explicit_a, "B": explicit_b}
        if len(aliases) < 2:
            log(f"failed: discovered {len(aliases)} usable profiles")
            return None
        return {"A": aliases[0], "B": aliases[1]}
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, TypeError, ValueError) as exc:
        log(f"failed: forced profile refresh failed: {_redact(str(exc))}")
        return None


def post_refresh_usage(account: str, alias: str, slot: int) -> Optional[Dict[str, Any]]:
    """Query codex-switch --json list --force to update cache and record sanitized primary 5h usage."""
    if not WARMUP_BIN.is_file() or not os.access(WARMUP_BIN, os.X_OK):
        log(f"account={account} slot={slot} post-refresh skipped: codex-switch is unavailable")
        return None
    try:
        result = subprocess.run(
            [str(WARMUP_BIN), "--json", "list", "--force"],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
    except subprocess.TimeoutExpired:
        log(f"account={account} slot={slot} post-refresh failed: command timed out")
        return None
    except OSError as exc:
        log(
            f"account={account} slot={slot} post-refresh failed: "
            f"unable to execute codex-switch: {_redact(str(exc))}"
        )
        return None

    if result.returncode != 0:
        detail = _redact((result.stderr or result.stdout or "").strip())
        log(
            f"account={account} slot={slot} post-refresh failed "
            f"exit_code={result.returncode} detail={detail or 'no diagnostic output'}"
        )
        return None

    try:
        data = json.loads(result.stdout)
    except (json.JSONDecodeError, TypeError, ValueError) as exc:
        log(
            f"account={account} slot={slot} post-refresh failed "
            f"detail=invalid JSON result: {_redact(str(exc))}"
        )
        return None

    profiles = data.get("profiles", []) if isinstance(data, dict) else []
    profile = next(
        (p for p in profiles if isinstance(p, dict) and p.get("alias") == alias),
        None,
    )
    if not profile:
        log(f"account={account} slot={slot} post-refresh detail=profile not found in list")
        return None

    usage = profile.get("usage")
    primary = usage.get("primary") if isinstance(usage, dict) else None

    used = primary.get("used_percent") if isinstance(primary, dict) else None
    resets_at = primary.get("resets_at") if isinstance(primary, dict) else None

    reset_str = "none"
    if isinstance(resets_at, (int, float)):
        try:
            dt = datetime.fromtimestamp(resets_at, tz=tz())
            reset_str = dt.strftime("%Y-%m-%d %H:%M:%S %Z")
        except Exception:
            reset_str = str(resets_at)
    elif resets_at is not None:
        reset_str = str(resets_at)

    used_str = f"{used}%" if used is not None else "none"
    log(
        f"account={account} slot={slot} post-refresh primary: "
        f"used={used_str} reset={_redact(reset_str)}"
    )

    return {
        "slot": slot,
        "at": now().isoformat(),
        "used_percent": used,
        "resets_at": resets_at,
    }


def due_slot(current: datetime, epoch: datetime, offset_minutes: int) -> int:
    elapsed = (
        current.timestamp()
        - (epoch + timedelta(minutes=offset_minutes)).timestamp()
    ) / 60
    return int(elapsed // SLOT_MINUTES)


def run_account(account: str, alias: str, slot: int) -> str:
    if not WARMUP_BIN.is_file() or not os.access(WARMUP_BIN, os.X_OK):
        log(f"account={account} slot={slot} skipped: codex-switch is unavailable")
        return "failed"
    try:
        result = subprocess.run(
            [str(WARMUP_BIN), "warmup", "--json", alias],
            capture_output=True,
            text=True,
            timeout=180,
            check=False,
        )
    except subprocess.TimeoutExpired:
        log(f"account={account} slot={slot} warmup failed detail=command timed out")
        return "failed"
    except OSError as exc:
        log(
            f"account={account} slot={slot} warmup failed "
            f"detail=unable to execute codex-switch: {_redact(str(exc))}"
        )
        return "failed"

    if result.returncode != 0:
        detail = _redact((result.stderr or result.stdout or "").strip())
        log(
            f"account={account} slot={slot} warmup failed "
            f"exit_code={result.returncode} detail={detail or 'no diagnostic output'}"
        )
        return "failed"

    try:
        payload = json.loads(result.stdout)
    except (json.JSONDecodeError, TypeError, ValueError) as exc:
        log(
            f"account={account} slot={slot} warmup failed "
            f"detail=invalid JSON result: {_redact(str(exc))}"
        )
        return "failed"

    results = payload.get("results") if isinstance(payload, dict) else None
    item = (
        next(
            (
                entry
                for entry in results
                if isinstance(entry, dict) and entry.get("alias") == alias
            ),
            None,
        )
        if isinstance(results, list)
        else None
    )
    if not isinstance(payload, dict) or item is None:
        log(
            f"account={account} slot={slot} warmup failed "
            "detail=missing result for target profile"
        )
        return "failed"
    if item.get("ok") is not True:
        detail = _redact(str(item.get("error") or "profile result was not successful"))
        log(f"account={account} slot={slot} warmup failed detail={detail}")
        return "failed"
    if payload.get("ok") is not True:
        detail = _redact(str(payload.get("error") or "overall result was not successful"))
        log(f"account={account} slot={slot} warmup failed detail={detail}")
        return "failed"

    skipped = item.get("skipped", False)
    if skipped is True:
        log(f"account={account} slot={slot} warmup skipped: active quota window")
        return "skipped"
    if skipped is not False:
        log(
            f"account={account} slot={slot} warmup failed "
            "detail=invalid skipped flag in profile result"
        )
        return "failed"

    log(f"account={account} slot={slot} warmup completed")
    return "completed"


def run_once() -> int:
    current = now()
    state = load_state()
    epoch = parse_local_datetime(state.get("epoch", EPOCH_TEXT))
    offsets = {"A": 0, "B": B_OFFSET_MINUTES}
    due: Dict[str, int] = {}
    state_modified = False

    for account in ("A", "B"):
        slot = due_slot(current, epoch, offsets[account])
        if slot < 0:
            if state["retry"].get(account) is not None:
                state["retry"][account] = None
                state_modified = True
            continue

        last = int(state["last_slot"].get(account, -1))
        if slot <= last:
            if state["retry"].get(account) is not None:
                state["retry"][account] = None
                state_modified = True
            continue

        # Check ongoing retry state
        retry_info = state["retry"].get(account)
        if retry_info is not None:
            retry_slot = retry_info.get("slot")
            if retry_slot != slot:
                # Newer slot arrived; discard stale retry
                state["retry"][account] = None
                retry_info = None
                state_modified = True
            else:
                attempts = int(retry_info.get("attempts", 0))
                if attempts >= MAX_RETRIES:
                    log(
                        f"account={account} slot={slot} warmup retry limit reached "
                        f"({attempts} attempts); consuming slot"
                    )
                    state["last_slot"][account] = slot
                    state["retry"][account] = None
                    state_modified = True
                    continue

                next_retry_str = retry_info.get("next_retry_at")
                if next_retry_str:
                    try:
                        next_retry_time = parse_local_datetime(next_retry_str)
                        if current < next_retry_time:
                            # Waiting for retry delay (>= 60s); throttle
                            continue
                    except Exception:
                        pass

        due[account] = slot

    if state_modified:
        save_state(state)

    if not due:
        return 0

    # A forced usage refresh is required even when aliases are explicitly
    # configured: codex-switch's warmup skip decision reads its usage cache.
    aliases = refresh_and_discover_aliases()
    if not aliases:
        for account, slot in due.items():
            existing = state["retry"].get(account)
            attempts = (
                existing["attempts"]
                if (existing and existing.get("slot") == slot)
                else 0
            ) + 1
            if attempts >= MAX_RETRIES:
                log(
                    f"account={account} slot={slot} profile refresh retry limit reached "
                    f"({attempts} attempts); consuming slot"
                )
                state["last_slot"][account] = slot
                state["retry"][account] = None
            else:
                next_retry = current + timedelta(seconds=RETRY_DELAY_SECONDS)
                state["retry"][account] = {
                    "slot": slot,
                    "attempts": attempts,
                    "next_retry_at": next_retry.isoformat(),
                    "reason": "refresh_failed",
                }
        save_state(state)
        return 0

    for account, slot in due.items():
        outcome = run_account(account, aliases[account], slot)
        if outcome == "completed":
            state["last_slot"][account] = slot
            state["retry"][account] = None
            save_state(state)

            refreshed = post_refresh_usage(account, aliases[account], slot)
            if refreshed:
                state["last_post_refresh"][account] = refreshed
                save_state(state)

        elif outcome == "skipped":
            # Active skip does NOT consume the slot!
            existing = state["retry"].get(account)
            attempts = (
                existing["attempts"]
                if (existing and existing.get("slot") == slot)
                else 0
            ) + 1
            if attempts >= MAX_RETRIES:
                log(
                    f"account={account} slot={slot} warmup retry limit reached "
                    f"({attempts} attempts); consuming slot"
                )
                state["last_slot"][account] = slot
                state["retry"][account] = None
            else:
                next_retry = current + timedelta(seconds=RETRY_DELAY_SECONDS)
                state["retry"][account] = {
                    "slot": slot,
                    "attempts": attempts,
                    "next_retry_at": next_retry.isoformat(),
                    "reason": "active_skip",
                }
            save_state(state)

        else:  # outcome == "failed"
            existing = state["retry"].get(account)
            attempts = (
                existing["attempts"]
                if (existing and existing.get("slot") == slot)
                else 0
            ) + 1
            if attempts >= MAX_RETRIES:
                log(
                    f"account={account} slot={slot} warmup retry limit reached "
                    f"({attempts} attempts); consuming slot"
                )
                state["last_slot"][account] = slot
                state["retry"][account] = None
            else:
                next_retry = current + timedelta(seconds=RETRY_DELAY_SECONDS)
                state["retry"][account] = {
                    "slot": slot,
                    "attempts": attempts,
                    "next_retry_at": next_retry.isoformat(),
                    "reason": "warmup_failed",
                }
            save_state(state)

    return 0


def acquire_singleton_lock():
    """Keep overlapping startup hooks from issuing duplicate warmups."""
    if fcntl is None:
        return None
    lock_path = STATE_FILE.with_suffix(STATE_FILE.suffix + ".lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    handle = lock_path.open("a+", encoding="utf-8")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return False
    try:
        os.chmod(lock_path, 0o600)
    except OSError:
        pass
    return handle


def main() -> int:
    singleton = acquire_singleton_lock()
    if singleton is False:
        return 0
    if os.environ.get("CODEX_WARMUP_ONCE") == "1":
        return run_once()

    log(
        f"started timezone={TIMEZONE_NAME} epoch={EPOCH_TEXT or 'first-local-day'} "
        "cycle=5d cadence=5h account_offset=150m"
    )
    while True:
        try:
            run_once()
        except Exception as exc:  # keep the daemon alive and fail closed
            log(f"iteration failed: {_redact(str(exc))}")
        time.sleep(max(1.0, POLL_SECONDS))


if __name__ == "__main__":
    raise SystemExit(main())
